import { TrackData } from "../data/track_data.slint";
import {
    MaterialPalette,
    MaterialTypography,
    MaterialStyleMetrics,
    MaterialText
} from "../../material-1.0/material.slint";

export component Track {
    in property <TrackData> track;
    in property <bool> playing;

    callback clicked();

    // Keep the row pitch in sync with Rust filtering and AppData.scroll().
    height: root.track.visible ? 84px : 0px;

    if root.track.visible: Rectangle {
        background: root.playing ? MaterialPalette.secondary_container : MaterialPalette.surface;
        border-radius: MaterialStyleMetrics.border_radius_12;

        HorizontalLayout {
            spacing: MaterialStyleMetrics.spacing_16;
            padding: MaterialStyleMetrics.padding_12;
            padding-top: 10px;
            padding-bottom: 10px;
            padding-left: root.playing ? MaterialStyleMetrics.padding_24 : MaterialStyleMetrics.padding_12;

            Rectangle {
                width: MaterialStyleMetrics.size_64;
                height: MaterialStyleMetrics.size_64;
                border-radius: MaterialStyleMetrics.border_radius_8;
                clip: true;

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.track.cover;
                    image-fit: cover;
                }
            }

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                min-width: 0px;

                MaterialText {
                    text: root.track.title;
                    style: MaterialTypography.title_medium;
                    color: root.playing ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface;
                    min-width: 0px;
                    overflow: elide;
                }

                MaterialText {
                    text: root.track.artist;
                    style: MaterialTypography.body_medium;
                    color: root.playing ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
                    min-width: 0px;
                    overflow: elide;
                }
            }

            MaterialText {
                text: root.track.time;
                style: MaterialTypography.label_medium;
                color: root.playing ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface_variant;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
        }

        Rectangle {
            border-radius: parent.border-radius;
            background: root.playing ? MaterialPalette.on_secondary_container : MaterialPalette.on_surface;
            opacity: touch.pressed ? 0.12 : 0;
        }

        touch := TouchArea {
            clicked => { root.clicked(); }
        }
    }
}
