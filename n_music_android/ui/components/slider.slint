import { MaterialStyleMetrics } from "../../material-1.0/ui/styling/material_style_metrics.slint";
import { MaterialPalette } from "../../material-1.0/ui/styling/material_palette.slint";
import { StateLayer } from "../../material-1.0/ui/components/state_layer.slint";

export component Slider {
    in property <bool> enabled: true;
    in-out property <float> value;
    in property <float> minimum;
    in property <int> stop_count: 0;
    in property <float> maximum: 100;

    callback released(value: float);
    callback value_changed(value: float);
    callback canceled();

    property <float> steps: root.stop_count > 0 ? (root.maximum - root.minimum) / root.stop_count : 1.0;
    property <float> keyboard_step: root.stop_count > 0 ? root.steps : (root.maximum - root.minimum) / 100.0;
    property <bool> dragging;
    property <float> drag_value;
    property <float> active_value: root.dragging ? root.drag_value : root.value;

    min-height: 36px;
    min-width: 0px;
    horizontal-stretch: 1;
    accessible-role: slider;
    accessible-enabled: root.enabled;
    accessible-value: root.active_value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.keyboard_step;
    accessible-action-set-value(value) => {
        if value.is-float() {
            root.commit_value(value.to-float());
        }
    }
    accessible-action-increment => { root.commit_value(root.value + root.keyboard_step); }
    accessible-action-decrement => { root.commit_value(root.value - root.keyboard_step); }
    forward-focus: focus_scope;

    // TouchArea may defer cancellation until the next pointer event.
    changed enabled => {
        if !root.enabled && root.dragging {
            root.dragging = false;
            root.canceled();
        }
    }

    focus_scope := FocusScope {
        enabled: root.enabled;

        touch_area := TouchArea {
            enabled: root.enabled;

            track := Rectangle {
                x: 0;
                height: MaterialStyleMetrics.size_4;
                background: MaterialPalette.surface_container_highest;
                border-radius: self.height / 2;

                Rectangle {
                    x: 0;
                    width: max(0px, state_layer.x - MaterialStyleMetrics.size_6);
                    border-top-left-radius: track.border-radius;
                    border-bottom-left-radius: track.border-radius;
                    border-top-right-radius: MaterialStyleMetrics.size_1;
                    border-bottom-right-radius: MaterialStyleMetrics.size_1;
                    background: thumb.background;
                }

                if root.stop_count > 0: Rectangle {
                    width: 100%;
                    height: 100%;

                    for i in root.stop_count: Rectangle {
                        x: root.value_to_length(track.width, root.minimum + (i + 1) * root.steps) - self.width / 2;
                        height: MaterialStyleMetrics.size_4;
                        width: self.height;
                        border-radius: self.height / 2;
                        background: MaterialPalette.outline;
                    }
                }
            }

            state_layer := Rectangle {
                x: root.value_to_length(track.width, root.active_value) - self.width / 2;
                width: 0;
                height: track.height + MaterialStyleMetrics.size_14 * 2;

                StateLayer {
                    height: track.height + MaterialStyleMetrics.size_16 * 2;
                    width: thumb.width + MaterialStyleMetrics.size_2 * 2;
                    border-radius: self.width / 2;
                    pressed: touch_area.pressed;
                    has_hover: touch_area.has_hover;
                    has_focus: focus_scope.has_focus;
                    enabled: root.enabled;
                    background: thumb.background;
                    display_background: touch_area.pressed || touch_area.has_hover || focus_scope.has_focus;

                    Rectangle {
                        height: track.height + MaterialStyleMetrics.size_14 * 2;
                        width: self.height;

                        thumb := Rectangle {
                            width: MaterialStyleMetrics.size_4;
                            border-radius: self.width / 2;
                            background: MaterialPalette.primary;
                        }
                    }
                }
            }

            moved => {
                if root.enabled && root.dragging {
                    root.drag_value = root.calculate_snapped_value(root.length_to_value(self.mouse_x, track.width));
                    root.value_changed(root.drag_value);
                }
            }

            pointer_event(event) => {
                if event.kind == PointerEventKind.cancel && root.dragging {
                    root.dragging = false;
                    root.canceled();
                } else if root.enabled && event.button == PointerEventButton.left {
                    if event.kind == PointerEventKind.down {
                        focus_scope.focus();
                        root.dragging = true;
                        root.drag_value = root.calculate_snapped_value(root.length_to_value(self.mouse_x, track.width));
                        root.value_changed(root.drag_value);
                    } else if event.kind == PointerEventKind.up && root.dragging {
                        root.commit_value(root.length_to_value(self.mouse_x, track.width));
                    }
                }
            }
        }

        key_pressed(event) => {
            if !root.enabled {
                return reject;
            }
            if event.text == Key.LeftArrow || event.text == Key.DownArrow {
                root.commit_value(root.value - root.keyboard_step);
                return accept;
            }
            if event.text == Key.RightArrow || event.text == Key.UpArrow {
                root.commit_value(root.value + root.keyboard_step);
                return accept;
            }
            reject
        }
    }

    pure function value_to_length(width: length, value: float) -> length {
        root.maximum > root.minimum ? clamp(width * (value - root.minimum) / (root.maximum - root.minimum), 0px, width) : 0px
    }

    pure function length_to_value(x: length, width: length) -> float {
        width > 0px ? x * (root.maximum - root.minimum) / width + root.minimum : root.minimum
    }

    pure function calculate_snapped_value(value: float) -> float {
        if root.stop_count > 0 && root.steps > 0 {
            return clamp(round((value - root.minimum) / root.steps) * root.steps + root.minimum, root.minimum, root.maximum);
        }
        clamp(value, root.minimum, root.maximum)
    }

    // Only user interactions emit callbacks; playback-driven value changes do not seek.
    function commit_value(value: float) {
        if root.enabled {
            root.dragging = false;
            root.value = root.calculate_snapped_value(value);
            root.value_changed(root.value);
            root.released(root.value);
        }
    }
}
