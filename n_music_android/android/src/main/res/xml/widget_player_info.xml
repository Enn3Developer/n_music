<?xml version="1.0" encoding="utf-8"?>
<!-- Four cells by two, as the design draws it; the cover gives way when it is narrower. The
     preview and the cells are Android 12's; earlier, the minimum sizes place it. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_player_description"
    android:initialLayout="@layout/widget_player"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/widget_player"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="s" />
